  "panels": [
    {
      "id": 1,
      "title": "Retention Cohort Heatmap, %",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(metric_date) AS Cohort, maxIf(value, metric_name = 'cohort_size') AS Users,\nround(maxIf(value, metric_name = 'retention_day_0') * 100, 1) AS `Day 0`,\nround(maxIf(value, metric_name = 'retention_day_1') * 100, 1) AS `Day 1`,\nround(maxIf(value, metric_name = 'retention_day_2') * 100, 1) AS `Day 2`,\nround(maxIf(value, metric_name = 'retention_day_3') * 100, 1) AS `Day 3`,\nround(maxIf(value, metric_name = 'retention_day_4') * 100, 1) AS `Day 4`,\nround(maxIf(value, metric_name = 'retention_day_5') * 100, 1) AS `Day 5`,\nround(maxIf(value, metric_name = 'retention_day_6') * 100, 1) AS `Day 6`,\nround(maxIf(value, metric_name = 'retention_day_7') * 100, 1) AS `Day 7`\nFROM cinema.daily_metrics WHERE $__dateFilter(metric_date) GROUP BY metric_date HAVING Users > 0 ORDER BY metric_date",
          "pluginVersion": "4.8.2"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "noValue": "",
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cohort"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Users"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "description": "Когорта по первому VIEW_STARTED. Возврат: любое событие в точный день жизни. Ненаступившие или незавершённые дни пустые."
    },
